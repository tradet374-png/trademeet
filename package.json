{
  "name": "trademeet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server:dev\" \"npm run client:dev\"",
    "client:dev": "vite",
    "client:build": "vite build",
    "server:dev": "tsx watch server/index.ts",
    "server:start": "tsx server/index.ts",
    "build": "vite build && tsx -e \"import fs from 'fs'; fs.copyFileSync('dist/index.html', 'dist/200.html'); fs.writeFileSync('dist/CNAME', 'trademeet-yeshwanth.surge.sh');\"",
    "start": "NODE_ENV=production tsx server/index.ts",
    "deploy:surge": "npm run build && npx surge dist trademeet-yeshwanth.surge.sh",
    "test:simulate": "tsx scripts/simulate-participants.ts"
  },
  "dependencies": {
    "@livekit/components-react": "^2.6.4",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "framer-motion": "^11.11.17",
    "lightweight-charts": "^4.2.1",
    "livekit-client": "^2.6.4",
    "livekit-server-sdk": "^2.6.4",
    "lucide-react": "^0.460.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.5.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.11"
  }
}
