# TradeMeet - Live Trading Community Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# Client URLs
VITE_API_URL=http://localhost:5000

# LiveKit SFU Configuration (For ultra-scalable 25+ participant video/audio/screenshare)
# Get your free cloud keys at https://cloud.livekit.io or use self-hosted LiveKit
LIVEKIT_URL=wss://trademeet-demo.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_livekit_key_trademeet_32_characters_min

# GIF Provider (Optional: GIPHY or Tenor. TradeMeet includes built-in curated GIFs if left blank)
GIPHY_API_KEY=
TENOR_API_KEY=

# TURN Server Configuration (Optional: 100% free account on https://www.metered.ca/tools/openrelay/)
# Bypasses strict Carrier-Grade NAT (CGNAT) on cellular 4G/5G mobile carriers
METERED_APP_NAME=
METERED_API_KEY=

# Persistence (Optional: SQLite in-memory/file is enabled by default; PostgreSQL supported for production)
DATABASE_URL=
REDIS_URL=
